NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/competitive-intelligence

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins. Compared case-insensitively
# and ignoring a trailing slash. A `*` matches one hostname label and must be
# written explicitly -- add the wildcard entry to allow Vercel preview
# deployments, which get a new hostname per build:
#   https://<project>-*.vercel.app
FRONTEND_URL=http://localhost:3000,https://competitors-intelligencev1.vercel.app,https://competitors-intelligencev1-*.vercel.app

# Phase 2 — News & Mentions
# Optional in development: live collection is disabled until this is set.
SERPAPI_API_KEY=
# Optional. Leave blank to store estimatedCost as null on ApiUsage records.
SERPAPI_ESTIMATED_COST_PER_REQUEST=
NEWS_MIN_RELEVANCE_SCORE=60
NEWS_REFRESH_COOLDOWN_MINUTES=5
